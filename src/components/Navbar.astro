---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import {
	LinkPreset,
	type NavBarBackground,
	type NavBarLink,
} from "../types/config";
import { isActiveLink, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import ImageWrapper from "./misc/ImageWrapper.astro";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const banner: string | undefined = Astro.props.banner;
const bannerBasePath: string | undefined = Astro.props.bannerBasePath;
const currentPath: string = Astro.props.currentPath ?? "";

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const defaultBackground: NavBarBackground = {
	type: "color",
	color: "var(--card-bg)",
	opacity: 1,
};
const backgroundConfig = navBarConfig.background ?? defaultBackground;
const backgroundOpacity = Math.min(
	Math.max(backgroundConfig.opacity ?? defaultBackground.opacity ?? 1, 0),
	1,
);
const useAutoImage = backgroundConfig.type === "auto" && !!banner;
const useImage = backgroundConfig.type === "image" || useAutoImage;
const imageSrc =
	backgroundConfig.type === "image" ? backgroundConfig.src : banner;
const imagePosition =
	backgroundConfig.type === "image"
		? backgroundConfig.position
		: backgroundConfig.type === "auto"
			? backgroundConfig.position
			: undefined;
const imageBasePath =
	backgroundConfig.type === "image"
		? backgroundConfig.basePath
		: bannerBasePath;
const backgroundColor =
	backgroundConfig.type === "color" && backgroundConfig.color
		? backgroundConfig.color
		: "var(--card-bg)";
const backgroundColorStyle = `background-color: color-mix(in oklch, ${backgroundColor} ${backgroundOpacity * 100}%, transparent);`;
---
<nav id="navbar" aria-label="主导航" class="z-50 relative w-full">
    <div class="absolute left-0 right-0 -top-8 h-[6.5rem] overflow-hidden pointer-events-none">
        {useImage && imageSrc ? (
            <ImageWrapper
                src={imageSrc}
                basePath={imageBasePath}
                position={imagePosition || "center"}
                class="w-full h-full"
                style={`opacity: ${backgroundOpacity};`}
            />
        ) : (
            <div class="w-full h-full" style={backgroundColorStyle}></div>
        )}
    </div>
    <div class:list={[
        className,
        "card-base !transition-none !overflow-visible w-full h-[4.5rem] !rounded-none flex items-center justify-between px-4"]}>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" aria-hidden="true" class="text-[1.75rem] mb-1 mr-2" />
                {siteConfig.title}
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                const active = isActiveLink(l.url, currentPath, l.external);
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null}
                          rel={l.external ? "noopener noreferrer" : null}
                          aria-current={active ? "page" : null}
                          class:list={[
                              "btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95",
                              { "nav-link-active": active },
                          ]}
                          data-nav-link={l.external ? null : l.url}
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:idle></Search>
            {!siteConfig.themeColor.fixed && (
                    <button type="button" aria-label="显示设置" aria-controls="display-setting" aria-expanded="false" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" aria-hidden="true" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:idle></LightDarkSwitch>
            <button type="button" aria-label="打开导航菜单" aria-controls="nav-menu-panel" aria-expanded="false" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" aria-hidden="true" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links} currentPath={currentPath}></NavMenuPanel>
        <DisplaySettings client:idle></DisplaySettings>
    </div>
</nav>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                const isClosed = settingPanel.classList.toggle("float-panel-closed");
                settingPanel.setAttribute("aria-hidden", String(isClosed));
                settingBtn.setAttribute("aria-expanded", String(!isClosed));
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                const isClosed = menuPanel.classList.toggle("float-panel-closed");
                menuPanel.setAttribute("aria-hidden", String(isClosed));
                menuBtn.setAttribute("aria-expanded", String(!isClosed));
            }
        };
    }
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

function schedulePagefind() {
    const run = () => void loadPagefind();
    if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 1500 });
    } else {
        window.setTimeout(run, 500);
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', schedulePagefind, { once: true });
} else {
    schedulePagefind();
}
</script>}

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
function updateNavActive() {
    const currentPath = window.location.pathname.replace(/\/$/, '');

    document.querySelectorAll('[data-nav-link], [data-nav-menu-link]').forEach((element) => {
        const rawUrl = element.getAttribute('data-nav-link') || element.getAttribute('data-nav-menu-link');
        if (!rawUrl) return;
        const resolved = (baseUrl + '/' + rawUrl).replace(/\/+/g, '/').replace(/\/$/, '');
        const active = rawUrl === '/' ? currentPath === resolved : currentPath === resolved || currentPath.startsWith(resolved + '/');
        element.classList.toggle('nav-link-active', active && element.hasAttribute('data-nav-link'));
        element.classList.toggle('nav-menu-active', active && element.hasAttribute('data-nav-menu-link'));
        if (active) element.setAttribute('aria-current', 'page');
        else element.removeAttribute('aria-current');
    });
}

updateNavActive();
if (window.swup) {
    window.swup.hooks.on('page:view', updateNavActive);
} else {
    document.addEventListener('swup:enable', () => {
        window.swup?.hooks.on('page:view', updateNavActive);
    }, { once: true });
}
</script>
